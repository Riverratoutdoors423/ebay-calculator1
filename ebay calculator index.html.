const shipping = parseFloat(document.getElementById('p-shipping').value) || 0;
const category = document.getElementById('p-category').value;
const promoted = (parseFloat(document.getElementById('p-promoted').value) || 0) / 100;


const feeRate = getFeeRate(category);
const ebayFee = price * feeRate;
const fixedFee = 0.30;
const promotedFee = price * promoted;


const totalFees = ebayFee + fixedFee + promotedFee;
const netProfit = price - totalFees - shipping - cost;
const margin = price > 0 ? (netProfit / price * 100) : 0;


// Update profit card
const card = document.getElementById('p-profit-card');
const amountEl = document.getElementById('p-profit-amount');
const marginEl = document.getElementById('p-profit-margin');


amountEl.textContent = '$' + Math.abs(netProfit).toFixed(2);
marginEl.textContent = Math.abs(margin).toFixed(1) + '% margin' + (netProfit < 0 ? ' (LOSS)' : '');


if (netProfit < 0) {
card.classList.add('negative');
card.style.background = 'linear-gradient(135deg, #ef4444, #dc2626)';
} else {
card.classList.remove('negative');
card.style.background = 'linear-gradient(135deg, #10b981, #059669)';
}


// Update breakdown
document.getElementById('p-bd-price').textContent = '$' + price.toFixed(2);
document.getElementById('p-bd-fees').textContent = '-$' + totalFees.toFixed(2);
document.getElementById('p-bd-shipping').textContent = '-$' + shipping.toFixed(2);
document.getElementById('p-bd-cost').textContent = '-$' + cost.toFixed(2);
document.getElementById('p-bd-total').textContent = (netProfit >= 0 ? '+' : '-') + '$' + Math.abs(netProfit).toFixed(2);
document.getElementById('p-bd-total').style.color = netProfit >= 0 ? 'var(--host-success)' : 'var(--host-error)';


// Show results
document.getElementById('p-results').classList.add('show');


// Draw chart
drawChart(price, cost, shipping, totalFees, netProfit);


// Save to current calc for history
window.currentCalc = { name, price, cost, shipping, fees: totalFees, profit: netProfit, margin, date: new Date().toISOString() };


// Update stats
updateStats(netProfit);
}


function drawChart(price, cost, shipping, fees, profit) {
const ctx = document.getElementById('p-chart').getContext('2d');


if (profitChart) profitChart.destroy();


profitChart = new Chart(ctx, {
type: 'doughnut',
data: {
labels: ['Net Profit', 'Item Cost', 'Shipping', 'eBay Fees'],
datasets: [{
data: [Math.max(0, profit), cost, shipping, fees],
backgroundColor: ['#10b981', '#ef4444', '#f59e0b', '#6366f1'],
borderWidth: 0
}]
},
options: {
responsive: true,
maintainAspectRatio: false,
plugins: {
legend: { display: false }
},
cutout: '70%'
}
});
}


function calculateBreakeven() {
const cost = parseFloat(document.getElementById('be-cost').value) || 0;
const shipping = parseFloat(document.getElementById('be-shipping').value) || 0;
const desired = parseFloat(document.getElementById('be-profit').value) || 0;
const feePct = (parseFloat(document.getElementById('be-fee').value) || 13.25) / 100;
const promoted = (parseFloat(document.getElementById('be-promoted').value) || 0) / 100;


const totalFeeRate = feePct + promoted;
const fixedFees = 0.30;
const total = cost + shipping + fixedFees + desired;


const breakEven = total / (1 - totalFeeRate);


document.getElementById('be-price').textContent = '$' + breakEven.toFixed(2);
document.getElementById('be-results').classList.add('show');
}


function calculateOptimal() {
const cost = parseFloat(document.getElementById('opt-cost').value) || 0;
const shipping = parseFloat(document.getElementById('opt-shipping').value) || 0;
const targetMargin = (parseFloat(document.getElementById('opt-margin').value) || 30) / 100;


const totalCost = cost + shipping + 0.30;
const feeRate = 0.1325;


const optimal = totalCost / (1 - feeRate - targetMargin);
const psychPrice = Math.ceil(optimal) - 0.01;


document.getElementById('opt-price').textContent = '$' + optimal.toFixed(2);
document.getElementById('opt-psych').textContent = '$' + psychPrice.toFixed(2);
document.getElementById('opt-results').classList.add('show');
}


function saveCalculation() {
if (!window.currentCalc) return;


calculations.unshift(window.currentCalc);
if (calculations.length > 20) calculations = calculations.slice(0, 20);


localStorage.setItem('ebayCalcs', JSON.stringify(calculations));
loadHistory();
showToast('Saved to history!');
}


function loadHistory() {
const section = document.getElementById('history-section');
const list = document.getElementById('history-list');


if (calculations.length === 0) {
section.style.display = 'none';
return;
}


section.style.display = 'block';
list.innerHTML = calculations.map((calc, i) => `
<div class="history-item" onclick="loadCalc(${i})">
<div class="history-info">
<div class="history-name">${calc.name}</div>
<div class="history-date">${new Date(calc.date).toLocaleDateString()}</div>
</div>
<div class="history-profit" style="color: ${calc.profit >= 0 ? 'var(--host-success)' : 'var(--host-error)'}">
${calc.profit >= 0 ? '+' : ''}$${calc.profit.toFixed(0)}
</div>
</div>
`).join('');
}


function loadCalc(index) {
const calc = calculations[index];
document.getElementById('p-name').value = calc.name;
document.getElementById('p-cost').value = calc.cost;
document.getElementById('p-price').value = calc.price;
document.getElementById('p-shipping').value = calc.shipping;
calculateProfit();
showToast('Loaded from history');
}


function clearHistory() {
calculations = [];
localStorage.removeItem('ebayCalcs');
loadHistory();
showToast('History cleared');
}


function updateStats(newProfit) {
const today = new Date().toDateString();
const todayCalcs = calculations.filter(c => new Date(c.date).toDateString() === today);


document.getElementById('stat-calcs').textContent = todayCalcs.length;


const avgMargin = todayCalcs.length > 0
? (todayCalcs.reduce((a, b) => a + b.margin, 0) / todayCalcs.length).toFixed(0) + '%'
: '-';
document.getElementById('stat-avg').textContent = avgMargin;


const total = todayCalcs.reduce((a, b) => a + b.profit, 0);
document.getElementById('stat-total').textContent = '$' + total.toFixed(0);
}


function shareResult() {
if (!window.currentCalc) return;
const text = `eBay Profit Calc: ${window.currentCalc.name} - Profit: $${window.currentCalc.profit.toFixed(2)} (${window.currentCalc.margin.toFixed(1)}% margin)`;


if (navigator.share) {
navigator.share({ title: 'eBay Profit Calc', text });
} else {
navigator.clipboard.writeText(text);
showToast('Copied to clipboard!');
}
}


function showToast(message) {
const toast = document.getElementById('toast');
toast.textContent = message;
toast.classList.add('show');
setTimeout(() => toast.classList.remove('show'), 2500);
}
